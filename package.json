{
  "name": "vite-plugin-portless",
  "version": "0.1.0",
  "description": "Show Vite listener URLs alongside Portless local and sharing URLs.",
  "keywords": [
    "localhost",
    "portless",
    "tailscale",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/gerardbalaoro/vite-plugin-portless#readme",
  "bugs": {
    "url": "https://github.com/gerardbalaoro/vite-plugin-portless/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerardbalaoro/vite-plugin-portless.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "oxlint --type-aware --type-check .",
    "prepare": "lefthook install",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "open": "^11.0.4",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "ultracite": "^8.1.0",
    "vite": "7.3.1",
    "vite-6": "npm:vite@6.4.1",
    "vite-7-0": "npm:vite@7.3.0",
    "vitest": "4.0.18",
    "yarn-classic": "npm:yarn@1.22.22"
  },
  "peerDependencies": {
    "vite": "^6.4.1 || ^7.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0"
}
